# Environment variables for this Next.js app. Copy to .env.local and fill in.
# Only this .env.example is committed - real .env* files are gitignored.
#
# `.env.schema` is the contract these variables must match, and the quality gate
# fails if this file and the schema drift apart. When you add a variable, declare
# it in both places.
#
# Rules:
# - Server-only secrets have NO prefix and never reach the browser.
# - NEXT_PUBLIC_* is inlined into the client bundle at build time - use it only
#   for values that are safe to expose to every visitor.

# --- Runtime ---
NODE_ENV=development
# Port the server listens on (the platform usually sets PORT).
# PORT=3000

# --- Public (shipped to the browser - no secrets here) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (server-only) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Serverless/edge deploys should point at a pooled connection string.
# DATABASE_POOL_URL=

# --- Auth / third-party secrets (server-only, uncomment as needed) ---
# AUTH_SECRET=
# Shared invite code that gates coach self-registration (/signup). Leave unset to
# disable open signup; set it to let coaches register with this code.
# AUTH_INVITE_CODE=
# API_KEY=

# --- Media (server-only) ---
# Base URL under which a game's chapter files (game_sources.file_path) are served
# to the watch player. Leave unset to serve the stored path as-is (e.g. files
# placed under public/ for local development).
# MEDIA_BASE_URL=https://media.example.com/hockey
# Base URL for downscaled proxy renditions used by the in-browser tagging player
# (ADR 0006). Proxies mirror each chapter's relative path under this root and keep
# the same duration, so the player plays lighter 720p bytes while full-res stays
# server-side for clip cutting. Leave unset to fall back to MEDIA_BASE_URL.
# MEDIA_PROXY_BASE_URL=https://media.example.com/hockey-proxy

# --- Clip cut worker (server-only) ---
# Directory the clip worker writes finished clips to. A clip's stored
# `output_path` is relative to it, so it is the filesystem counterpart of
# MEDIA_BASE_URL. Required by the worker process only; the web app never reads
# it. Chapters are read from here too unless MEDIA_SOURCE_ROOT is set.
# CLIP_MEDIA_ROOT=/srv/media
# Subdirectory of CLIP_MEDIA_ROOT the worker writes cut clips into. Defaults to
# `clips`, so a finished clip is stored as `clips/<clip-id>.mp4`.
# CLIP_OUTPUT_DIR=clips
# Read-only directory the chapter originals are read from: the Google Drive
# mount (ADR 0008, docs/ops/google-drive-mount.md). `game_sources.file_path` is
# relative to it. The clip worker falls back to CLIP_MEDIA_ROOT; the ingest
# worker requires it.
# MEDIA_SOURCE_ROOT=/media/source

# --- Drive import worker (server-only) ---
# Directory the ingest worker writes the 720p tagging proxies to, each at its
# chapter's relative path: the filesystem counterpart of MEDIA_PROXY_BASE_URL.
# Required by the ingest worker.
# MEDIA_PROXY_ROOT=/srv/media/proxy
# Minutes a new game folder on Drive must stay unchanged before it is imported,
# so a half-uploaded game is not imported early. Defaults to 120.
# INGEST_QUIET_MINUTES=120
# Thread cap for one proxy encode (it also runs at the lowest CPU priority).
# Defaults to 2.
# INGEST_PROXY_THREADS=2

# --- Share links (server-only) ---
# Optional seed for the team clip share link (/share/team/<token>). Anyone with the
# link sees the team's ready clips with no login, so treat it as a secret - never
# NEXT_PUBLIC. It is copied into the database once, on first use; from then on the
# coach creates or replaces the link under Einstellungen > Teilen and a change
# here has no effect. Leave unset to start with the team view off.
# TEAM_SHARE_TOKEN=

# --- Ingest (server-only) ---
# Shared secret the hockey-video-pipeline presents (Authorization: Bearer <token>)
# when it registers a stitched game via POST /api/ingest. A secret - never
# NEXT_PUBLIC. Rotate by changing this value. Leave unset to disable auto-ingest.
# INGEST_TOKEN=

# --- Legal pages (server-only) ---
# Operator details for the Impressum (/impressum) and the Datenschutzerklärung
# (/datenschutz). Personal data of the operator, so they live only in the
# environment, never in the repo. While name, street, city or email is unset the
# pages show a notice instead of the missing details.
# LEGAL_OPERATOR_NAME=Max Mustermann
# LEGAL_OPERATOR_STREET=Musterstraße 1
# LEGAL_OPERATOR_CITY=12345 Musterstadt
# LEGAL_CONTACT_EMAIL=kontakt@example.com
# Optional contact phone number, shown in the Impressum when set.
# LEGAL_CONTACT_PHONE=
# Optional name and address of the server hoster, named in the privacy policy
# as a processor. Leave unset to describe the hosting generically.
# LEGAL_HOSTING_PROVIDER=
