{
  "contract": "cut-plan",
  "description": "resolveClipEnd is the game time a tag's clip ends at: its stored end, else its type's default postS after the start (tag-types.json), else fallbackClipWindowS for an unknown type. planClipCut orders the chapters by orderIndex (they must be exactly 0..N-1) and splits the window into the per-file pieces [localStartS, localEndS) a cutter copies and joins in order.",
  "reference": [
    "src/features/clips/cut/window.ts",
    "src/features/clips/boundary/cut-plan.ts"
  ],
  "tolerance": 1e-9,
  "constants": { "fallbackClipWindowS": 20 },
  "cases": [
    {
      "name": "a stored end wins",
      "call": "resolveClipEnd",
      "input": { "startS": 515, "endS": 530, "tagType": "goal" },
      "returns": 530
    },
    {
      "name": "a goal without an end",
      "call": "resolveClipEnd",
      "input": { "startS": 515, "endS": null, "tagType": "goal" },
      "returns": 520
    },
    {
      "name": "a short corner without an end",
      "call": "resolveClipEnd",
      "input": { "startS": 515, "endS": null, "tagType": "corner_short" },
      "returns": 521
    },
    {
      "name": "an unknown type without an end",
      "call": "resolveClipEnd",
      "input": { "startS": 515, "endS": null, "tagType": "retired_type" },
      "returns": 535
    },
    {
      "name": "rejects a negative start",
      "call": "resolveClipEnd",
      "input": { "startS": -1, "endS": null, "tagType": "goal" },
      "throws": true
    },
    {
      "name": "rejects an end at the start",
