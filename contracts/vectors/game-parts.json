{
  "contract": "game-parts",
  "description": "The game parts among a folder's file names, in play order. Three schemes count, matched case-insensitively: halbzeit<N> and viertel<N> (.mp4 or .mov), and GoPro chapters G[XH]<CC><NNNN>.MP4 ordered by recording NNNN, then chapter CC. Other files are ignored and listed in code-unit order. A folder mixing schemes, repeating or skipping a part, or holding more than maxParts parts is invalid (its English reason is left out).",
  "reference": ["src/features/ingest/parts.ts"],
  "tolerance": 1e-9,
  "constants": { "maxParts": 100 },
  "cases": [
    {
      "name": "GoPro chapters in any listing order",
      "call": "selectGameParts",
      "input": {
        "fileNames": ["GX020042.MP4", "GX030042.MP4", "GX010042.MP4"]
      },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["GX010042.MP4", "GX020042.MP4", "GX030042.MP4"],
        "ignored": []
      }
    },
    {
      "name": "two recordings play in recording order",
      "call": "selectGameParts",
      "input": {
        "fileNames": ["GX010043.MP4", "GX020042.MP4", "GX010042.MP4"]
      },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["GX010042.MP4", "GX020042.MP4", "GX010043.MP4"],
        "ignored": []
      }
    },
    {
      "name": "H.264 chapters",
      "call": "selectGameParts",
      "input": { "fileNames": ["GH020007.MP4", "GH010007.MP4"] },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["GH010007.MP4", "GH020007.MP4"],
        "ignored": []
      }
    },
    {
      "name": "HEVC and H.264 recordings are one scheme",
      "call": "selectGameParts",
      "input": { "fileNames": ["GX010008.MP4", "GH010007.MP4"] },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["GH010007.MP4", "GX010008.MP4"],
        "ignored": []
      }
    },
    {
      "name": "lower-case names",
      "call": "selectGameParts",
      "input": { "fileNames": ["gx020042.mp4", "gx010042.mp4"] },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["gx010042.mp4", "gx020042.mp4"],
        "ignored": []
      }
    },
    {
      "name": "a camera card's side files are ignored",
      "call": "selectGameParts",
      "input": {
        "fileNames": [
          "GX010042.MP4",
          "GX010042.THM",
          "GL010042.LRV",
          "GX020042.MP4",
          "GL020042.LRV"
        ]
      },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["GX010042.MP4", "GX020042.MP4"],
        "ignored": ["GL010042.LRV", "GL020042.LRV", "GX010042.THM"]
      }
    },
    {
      "name": "other files in a game folder are ignored",
      "call": "selectGameParts",
      "input": {
        "fileNames": ["notes.txt", "GX010042.MP4", "Tor.MOV", "cover.jpg"]
      },
      "returns": {
        "kind": "parts",
        "scheme": "gopro",
        "parts": ["GX010042.MP4"],
        "ignored": ["Tor.MOV", "cover.jpg", "notes.txt"]
      }
    },
    {
      "name": "exported halves",
      "call": "selectGameParts",
      "input": { "fileNames": ["Halbzeit 2.mp4", "halbzeit1.mp4"] },
      "returns": {
        "kind": "parts",
        "scheme": "halbzeit",
        "parts": ["halbzeit1.mp4", "Halbzeit 2.mp4"],
        "ignored": []
      }
    },
    {
      "name": "exported quarters",
      "call": "selectGameParts",
      "input": {
        "fileNames": [
          "Viertel_3.MOV",
          "viertel1.mp4",
          "Viertel-2.mp4",
          "viertel4.mov"
        ]
      },
      "returns": {
        "kind": "parts",
        "scheme": "viertel",
        "parts": [
          "viertel1.mp4",
          "Viertel-2.mp4",
          "Viertel_3.MOV",
          "viertel4.mov"
        ],
        "ignored": []
      }
    },
    {
      "name": "a folder without parts",
      "call": "selectGameParts",
      "input": { "fileNames": ["notes.txt", "cover.jpg"] },
      "returns": { "kind": "none", "ignored": ["cover.jpg", "notes.txt"] }
    },
    {
      "name": "an empty folder",
      "call": "selectGameParts",
      "input": { "fileNames": [] },
      "returns": { "kind": "none", "ignored": [] }
    },
    {
      "name": "mixed schemes are invalid",
      "call": "selectGameParts",
      "input": { "fileNames": ["halbzeit1.mp4", "GX010042.MP4"] },
      "returns": { "kind": "invalid" }
    },
    {
      "name": "a repeated part is invalid",
      "call": "selectGameParts",
      "input": { "fileNames": ["halbzeit1.mp4", "Halbzeit 1.mp4"] },
      "returns": { "kind": "invalid" }
    },
    {
      "name": "a missing chapter is invalid",
      "call": "selectGameParts",
      "input": { "fileNames": ["GX010042.MP4", "GX030042.MP4"] },
      "returns": { "kind": "invalid" }
    },
    {
      "name": "a recording without its first chapter is invalid",
      "call": "selectGameParts",
      "input": { "fileNames": ["GX020042.MP4"] },
      "returns": { "kind": "invalid" }
    },
    {
      "name": "a missing half is invalid",
      "call": "selectGameParts",
      "input": { "fileNames": ["halbzeit2.mp4"] },
      "returns": { "kind": "invalid" }
    },
