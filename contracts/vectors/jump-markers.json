{
  "contract": "jump-markers",
  "description": "A marker is a tag's start on the game timeline. sortMarkers orders by start; markers with the same start keep their order. nextMarker and previousMarker are the first marker after, and the last before, the play position, skipping any marker within 0.25 s of it so repeated presses move on (null at either end). activeMarker is the marker within 0.25 s of the play position, the nearest when several are and the one listed last on a tie. markerFraction places a start on the timeline in [0, 1], 0 while the game has no length.",
  "reference": ["src/features/player/jump-markers/navigation.ts"],
  "tolerance": 1e-9,
  "cases": [
    {
      "name": "markers in any order",
      "call": "sortMarkers",
      "input": {
        "markers": [
          { "id": "c", "type": "action_bad", "startS": 1500 },
          { "id": "a", "type": "goal", "startS": 300 },
          { "id": "b", "type": "corner_short", "startS": 900 },
          { "id": "d", "type": "action_good", "startS": 900.2 }
        ]
      },
      "returns": [
        { "id": "a", "type": "goal", "startS": 300 },
        { "id": "b", "type": "corner_short", "startS": 900 },
        { "id": "d", "type": "action_good", "startS": 900.2 },
        { "id": "c", "type": "action_bad", "startS": 1500 }
      ]
    },
    {
      "name": "equal starts keep their order",
      "call": "sortMarkers",
      "input": {
        "markers": [
          { "id": "x", "type": "goal", "startS": 60 },
          { "id": "y", "type": "goal", "startS": 60 }
        ]
      },
      "returns": [
        { "id": "x", "type": "goal", "startS": 60 },
        { "id": "y", "type": "goal", "startS": 60 }
      ]
    },
    {
      "name": "nothing to sort",
      "call": "sortMarkers",
      "input": { "markers": [] },
