{
  "contract": "tag-validation",
  "description": "parseTagInput validates a new tag: a game id (a UUID), a type from tag-types.json, a finite start of at least 0, and an optional end that must lie after the start (absent or null is stored as null, the type's default window). parseTagEditInput validates an edit the same way without the game id. Error texts are left out.",
  "reference": [
    "src/features/tagging/validation.ts",
    "src/features/tagging/edit/validation.ts"
  ],
  "tolerance": 1e-9,
  "cases": [
    {
      "name": "a tag with an explicit end",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "goal",
          "startS": 990,
          "endS": 1005
        }
      },
      "returns": {
        "ok": true,
        "value": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "goal",
          "startS": 990,
          "endS": 1005
        }
      }
    },
    {
      "name": "a missing end is stored as null",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "corner_short",
          "startS": 992
        }
      },
      "returns": {
        "ok": true,
        "value": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "corner_short",
          "startS": 992,
          "endS": null
        }
      }
    },
    {
      "name": "a null end is stored as null",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "action_bad",
          "startS": 0,
          "endS": null
        }
      },
      "returns": {
        "ok": true,
        "value": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "action_bad",
          "startS": 0,
          "endS": null
        }
      }
    },
    {
      "name": "rejects a body that is not an object",
      "call": "parseTagInput",
      "input": { "body": "goal" },
      "returns": { "ok": false }
    },
    {
      "name": "rejects a malformed game id",
      "call": "parseTagInput",
      "input": {
        "body": { "gameId": "game-1", "type": "goal", "startS": 990 }
      },
      "returns": { "ok": false }
    },
    {
      "name": "rejects an unknown type",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "retired_type",
          "startS": 990
        }
      },
      "returns": { "ok": false }
    },
    {
      "name": "rejects a type given by its label",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "Tor",
          "startS": 990
        }
      },
      "returns": { "ok": false }
    },
    {
      "name": "rejects a negative start",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "goal",
          "startS": -1
        }
      },
      "returns": { "ok": false }
    },
    {
      "name": "rejects a start that is not a number",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "goal",
          "startS": "990"
        }
      },
      "returns": { "ok": false }
    },
    {
      "name": "rejects an end at the start",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "goal",
          "startS": 990,
          "endS": 990
        }
      },
      "returns": { "ok": false }
    },
    {
      "name": "rejects an end that is not a number",
      "call": "parseTagInput",
      "input": {
        "body": {
          "gameId": "00000000-0000-4000-8000-000000000001",
          "type": "goal",
          "startS": 990,
          "endS": "1005"
        }
      },
      "returns": { "ok": false }
    },
    {
      "name": "an edit with an explicit end",
      "call": "parseTagEditInput",
      "input": {
        "body": { "type": "action_good", "startS": 1226.56, "endS": 1238.56 }
      },
      "returns": {
        "ok": true,
        "value": { "type": "action_good", "startS": 1226.56, "endS": 1238.56 }
      }
    },
    {
      "name": "an edit back to the default window",
      "call": "parseTagEditInput",
      "input": { "body": { "type": "goal", "startS": 990, "endS": null } },
      "returns": {
        "ok": true,
        "value": { "type": "goal", "startS": 990, "endS": null }
      }
    },
    {
      "name": "a game id in an edit is ignored",
      "call": "parseTagEditInput",
      "input": {
        "body": { "gameId": "game-1", "type": "goal", "startS": 990 }
      },
      "returns": {
        "ok": true,
        "value": { "type": "goal", "startS": 990, "endS": null }
      }
    },
    {
      "name": "rejects an edit that is not an object",
      "call": "parseTagEditInput",
      "input": { "body": null },
      "returns": { "ok": false }
    },
    {
      "name": "rejects an edit with an unknown type",
      "call": "parseTagEditInput",
      "input": { "body": { "type": "retired_type", "startS": 990 } },
      "returns": { "ok": false }
    },
    {
      "name": "rejects an edit with a negative start",
      "call": "parseTagEditInput",
      "input": { "body": { "type": "goal", "startS": -0.5 } },
      "returns": { "ok": false }
    },
    {
      "name": "rejects an edit ending before its start",
      "call": "parseTagEditInput",
      "input": { "body": { "type": "goal", "startS": 990, "endS": 989 } },
      "returns": { "ok": false }
    }
  ]
}
